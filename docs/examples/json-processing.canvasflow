        "h": 260,
        "ports": [
          {
            "id": "in-value",
            "name": "输入变量",
            "dir": "in",
            "type": "any",
            "description": "一个文本、JSON 或媒体资产值；此端口不接收多条连线。",
            "required": false,
            "cardinality": "one"
          },
          {
            "id": "out-value",
            "name": "输出变量",
            "dir": "out",
            "type": "any",
            "description": "透传时保留原值类型；取字段保留其文本或 JSON 类型；模板模式输出文本。",
            "required": true,
            "cardinality": "one"
          }
        ],
        "params": {
          "config": "{\"operation\":\"template\",\"template\":\"电影镜头：{{value}}\",\"valueType\":\"any\"}"
