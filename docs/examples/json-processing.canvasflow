        "contractVersion": 1,
        "title": "4 组织为场景数据",
        "x": 1250,
        "y": 160,
        "w": 340,
        "h": 260,
        "ports": [
          {
            "id": "in-context",
            "name": "结构上下文",
            "dir": "in",
            "type": "json",
            "description": "一个或多个已连接的结构化输入，可在正文中用 {{input[0].field}} 显式引用。",
            "required": false,
            "cardinality": "many",
            "schema": {
              "id": "json.any",
              "version": 1
            }
          },
          {
            "id": "in-text",
            "name": "文本上下文",
            "dir": "in",
            "type": "text",
            "description": "可在正文中用 {{text}} 显式引用的上游文本。",
            "required": false,
            "cardinality": "many"
          },
          {
            "id": "out-json",
            "name": "结构数据",
            "dir": "out",
            "type": "json",
            "description": "经所选 Schema 校验后的结构化数据。",
            "required": true,
            "cardinality": "one",
            "schema": {
              "id": "scene.definition",
              "version": 1
            }
          }
        ],
        "params": {
          "config": "{\"schema\":{\"id\":\"scene.definition\",\"version\":1}}"
        },
        "content": {
          "kind": "text",
          "text": "{\n  \"id\": \"scene01\",\n  \"name\": \"古书房\",\n  \"description\": \"{{text}}\"\n}"
        },
        "exec": {
          "status": "success"
        },
        "meta": {
          "source": "input",
          "createdAt": 1791207197860
        }
