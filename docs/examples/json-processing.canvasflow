        "title": "1 保存原始JSON",
        "x": 170,
        "y": 160,
        "w": 340,
        "h": 260,
        "ports": [
          {
            "id": "in-json",
            "name": "数据",
            "dir": "in",
            "type": "json",
            "description": "优先输入：一条保留原值；多条按连线顺序汇总为 JSON 数组。",
            "required": false,
            "cardinality": "many",
            "schema": {
              "id": "json.any",
              "version": 1
            }
          },
          {
            "id": "in-text",
            "name": "文本",
            "dir": "in",
            "type": "text",
            "description": "仅在没有 JSON 数据输入时解析；两类同时连接时使用 JSON 数据。",
            "required": false,
            "cardinality": "one"
          },
          {
            "id": "out-json",
            "name": "数据",
            "dir": "out",
            "type": "json",
            "description": "校验并格式化后的结构化值。",
            "required": true,
            "cardinality": "one",
            "schema": {
              "id": "json.any",
              "version": 1
            }
          }
        ],
        "params": {},
        "content": {
          "kind": "text",
          "text": "{\n  \"description\": \"人物走进书房，打开一卷古书\",\n  \"duration\": 5\n}"
        },
        "exec": {
          "status": "idle"
        },
        "meta": {
          "source": "input",
          "createdAt": 1791207197860
        }
      },
      {
        "id": "shape:example-1",
        "type": "processor",
        "contractVersion": 1,
        "title": "2 提取description",
        "x": 530,
        "y": 160,
        "w": 340,
        "h": 260,
        "ports": [
          {
            "id": "in-value",
            "name": "输入变量",
            "dir": "in",
            "type": "any",
            "description": "一个文本、JSON 或媒体资产值；此端口不接收多条连线。",
            "required": false,
            "cardinality": "one"
          },
          {
            "id": "out-value",
            "name": "输出变量",
            "dir": "out",
            "type": "any",
            "description": "透传时保留原值类型；取字段保留其文本或 JSON 类型；模板模式输出文本。",
            "required": true,
            "cardinality": "one"
          }
        ],
        "params": {
          "config": "{\"operation\":\"pick\",\"path\":\"description\",\"valueType\":\"any\"}"
        },
        "content": {
          "kind": "empty"
        },
        "exec": {
          "status": "success"
        },
        "meta": {
          "source": "input",
          "createdAt": 1791207197860
        }
      },
      {
