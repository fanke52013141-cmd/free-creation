# Development server
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TASK_WORKERS=1

# Public model profiles. `api_key_env` points to an environment variable; do not put
# actual secrets in this JSON or commit them. Sync these profiles from the UI.
#
# MODEL_PROFILES_JSON=[
#   {"id":"chat-default","name":"默认对话","type":"chat","provider":"openai-compatible","base_url":"https://provider.example/v1","model_id":"your-chat-model","api_key_env":"CHAT_API_KEY"},
#   {"id":"image-default","name":"默认图片","type":"image","provider":"openai-compatible","base_url":"https://provider.example/v1","model_id":"your-image-model","api_key_env":"IMAGE_API_KEY"},
#   {"id":"seedance-mini","name":"Seedance 2.0 Mini","type":"video","provider":"seedance","base_url":"https://provider.example/gateway/ark/v3","model_id":"seedance-2.0-mini","api_key_env":"VIDEO_API_KEY","task_path":"/generations/tasks","status_path_template":"/generations/tasks/{task_id}"}
# ]
# CHAT_API_KEY=...
# IMAGE_API_KEY=...
# VIDEO_API_KEY=...
