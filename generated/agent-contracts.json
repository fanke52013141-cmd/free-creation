        "type": "object",
        "properties": {
          "startTime": {
            "type": "number",
            "description": "开始时间（秒）",
            "minimum": 0
          },
          "endTime": {
            "type": "number",
            "description": "结束时间（秒）",
            "minimum": 0
          }
        },
        "required": [
          "startTime",
