{
  "mcpTools": [
    {
      "name": "node.chat",
      "description": "AI 对话 — 使用大语言模型进行文本对话。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          },
          "systemPrompt": {
            "type": "string",
            "description": "系统提示词"
          },
          "temperature": {
            "type": "number",
            "description": "温度参数",
            "default": 0.7,
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.director",
      "description": "导演台 — 编排多步骤创作流程的总控节点。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.ai-process",
      "description": "AI 流程 — 自定义多步 AI 处理流程。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "description": "处理步骤"
          }
        },
        "required": [
          "steps"
        ]
      }
    },
    {
      "name": "node.speech",
      "description": "语音对话 — 语音输入与 AI 对话。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.storyboard",
      "description": "分镜生成 — 根据文本生成分镜脚本（镜头列表 JSON）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          },
          "shotCount": {
            "type": "number",
            "description": "期望镜头数",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.structured",
      "description": "结构化提取 — 使用 AI 从文本中提取结构化 JSON 数据。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          },
          "schema": {
            "type": "object",
            "description": "期望的 JSON Schema"
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.audio",
      "description": "音频 — 导入本地音频文件，作为下游节点的音频输入。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "已导入的媒体资产 ID"
          }
        },
        "required": []
      }
    },
    {
      "name": "node.tts",
      "description": "语音合成 — 将文本转换为语音。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "voice": {
            "type": "string",
            "description": "音色 ID"
          },
          "speed": {
            "type": "number",
            "description": "语速",
            "default": 1,
            "minimum": 0.5,
            "maximum": 2
          }
        },
        "required": []
      }
    },
    {
      "name": "node.vocal-separate",
      "description": "人声分离 — 将音频分离为人声和伴奏。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "node.code",
      "description": "代码执行 — 执行 JavaScript/TypeScript 代码片段。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "代码内容"
          }
        },
        "required": [
          "code"
        ]
      }
    },
    {
      "name": "node.iterate",
      "description": "循环迭代 — 对列表中的每一项执行循环体子流程。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "variableName": {
            "type": "string",
            "description": "循环变量名",
            "default": "item"
          }
        },
        "required": []
      }
    },
    {
      "name": "node.image-crop",
      "description": "图片裁剪 — 按照固定比例或自由区域裁剪图片。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "description": "裁剪模式：固定比例或自由裁剪",
            "enum": [
              "fixed-ratio",
              "free"
            ],
            "default": "fixed-ratio"
          },
          "ratio": {
            "type": "string",
            "description": "裁剪比例（仅 fixed-ratio 模式有效）",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ]
          },
          "cropRect": {
            "type": "object",
            "description": "自定义裁剪区域 {x, y, w, h}"
          }
        },
        "required": [
          "mode"
        ]
      }
    },
    {
      "name": "node.image-edit",
      "description": "图片修改 — 使用 AI 模型对已有图片进行修改和重绘。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          },
          "mask": {
            "type": "string",
            "description": "蒙版区域（base64 或区域描述）"
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.image-gen",
      "description": "图片生成 — 使用 AI 模型根据提示词生成图片。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "string",
            "description": "供应商 ID"
          },
          "modelId": {
            "type": "string",
            "description": "模型 ID"
          },
          "ratio": {
            "type": "string",
            "description": "图片比例",
            "enum": [
              "1:1",
              "16:9",
              "9:16",
              "4:3",
              "3:4"
            ],
            "default": "1:1"
          },
          "seed": {
            "type": "number",
            "description": "随机种子（-1 为随机）"
          }
        },
        "required": [
          "providerId",
          "modelId"
        ]
      }
    },
    {
      "name": "node.image",
      "description": "图片 — 导入本地图片文件，作为下游节点的图片输入。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "已导入的媒体资产 ID"
          }
        },
        "required": []
      }
    },
    {
      "name": "node.image-split",
      "description": "宫格拆分 — 将一张图片按 N×M 宫格拆分为多张子图。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "number",
            "description": "行数",
            "default": 2,
            "minimum": 1,
            "maximum": 10
          },
          "cols": {
            "type": "number",
            "description": "列数",
            "default": 2,
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "rows",
          "cols"
        ]
      }
    },
    {
      "name": "node.json",
      "description": "JSON — 结构化 JSON 数据，作为下游节点的 JSON 输入。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "JSON 数据内容"
          }
        },
        "required": []
      }
    },
    {
      "name": "node.processor",
      "description": "文本处理器 — 对文本执行格式化、提取或变换。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "处理模板（支持变量替换）"
          }
        },
        "required": [
          "template"
        ]
      }
    },
    {
      "name": "node.text",
      "description": "文本 — 可编辑的原始文本。连线输出会作为下游节点的文本输入。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "节点文本内容"
          }
        },
        "required": []
      }
    },
    {
