      "inputSchema": {
        "type": "object",
        "properties": {
          "timestamps": {
            "type": "array",
            "description": "取帧时间点列表（秒）"
          },
          "count": {
            "type": "number",
            "description": "均匀取帧数量",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": []
      }
    },
    {
      "name": "node.video",
      "description": "视频 — 导入本地视频文件，作为下游节点的视频输入。",
