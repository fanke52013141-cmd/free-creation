{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["test/**/*.test.ts", "test/helpers/**/*", "vitest.config.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  }
}
