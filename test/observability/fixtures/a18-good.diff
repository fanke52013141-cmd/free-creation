+// 新增网络功能：接入了统一诊断事件（model.request.* 边界）。
+import { emitGatewayEvent } from '../diagnostics/gateway-events'
+export async function callNewUpstream(url: string): Promise<unknown> {
+  emitGatewayEvent('model.request.started', '请求开始', { traceId: 'trace-x' }, {})
+  const res = await fetch(url)
+  return res.json()
+}
